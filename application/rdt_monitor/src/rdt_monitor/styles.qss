QWidget {
    background-color: #0F1115;
    color: #E8EAED;
    font-size: 13px;
}
QLabel { background: transparent; }
QLabel#title { font-size: 18px; font-weight: 600; }
QWidget#monitorHeader { background: transparent; border-bottom: 1px solid #253443; }
QFrame#toolbarDivider { background: #39414D; border: none; }
QWidget#monitorHeader QPushButton { padding: 6px 12px; min-height: 0; border-radius: 4px; }
QWidget#monitorHeader QPushButton:focus { padding: 5px 11px; }
QWidget#monitorHeader QPushButton:checked { background: #20394E; border-color: #60A5FA; }
QWidget#monitorHeader QLineEdit { padding: 6px 10px; }
QWidget#cameraToolbar, QScrollArea#monitorControlsScroll { background: transparent; }
QWidget#cameraToolbar QPushButton { padding: 6px 12px; min-height: 0; border-radius: 4px; }
QWidget#cameraToolbar QPushButton:focus { padding: 5px 11px; }
QLabel#sectionTitle { font-size: 15px; font-weight: 500; }
QLabel#caption { color: #9AA0A6; font-size: 12px; }
QLabel#counter { font-size: 26px; font-weight: 600; }
QLabel#warning { color: #EAB308; padding: 4px 0; }
QWidget#monitorSurface { background-color: #080F16; }
QFrame#cameraPanel, QFrame#verdictPanel, QFrame#controlPanel {
    background-color: #0C151F;
    border: 1px solid #253443;
    border-radius: 6px;
}
QLabel#panelTitle { color: #D8E2EE; font-size: 12px; font-weight: 600; }
QLabel#cameraConnection { color: #A7B4C4; font-size: 12px; }
QLabel#cameraConnection[connected="true"] { color: #60A5FA; }
QLabel#cycleVerdict {
    background: transparent;
    border: none;
    padding: 0;
}
QLabel#defectAlarm { color: #9AA0A6; padding: 4px 0; }
QLabel#defectAlarm[latched="true"] { color: #FB7185; font-weight: 600; }
QPushButton {
    background: #1E222B;
    border: 1px solid #2A2F3A;
    border-radius: 6px;
    padding: 9px 12px;
    min-height: 20px;
}
QPushButton:hover { background: #2A2F3A; border-color: #9AA0A6; }
QPushButton:pressed { background: #171A21; }
QPushButton:focus { border: 2px solid #3B82F6; padding: 8px 11px; }
QPushButton:disabled { color: #9AA0A6; background: #171A21; }
QPushButton#primary { background: #3B82F6; color: #0F1115; font-weight: 600; }
QPushButton#primary:hover { background: #60A5FA; }
QPushButton#primary:pressed { background: #2563EB; color: #E8EAED; }
QPushButton#primary:disabled { background: #171A21; color: #9AA0A6; }
QPushButton#primary:focus { border-color: #E8EAED; }
QFrame#controlPanel QPushButton#primary { background: #195C32; color: #E8EAED; border-color: #389C59; }
QFrame#controlPanel QPushButton#primary:hover { background: #227542; }
QFrame#controlPanel QPushButton#primary:pressed { background: #124526; }
QFrame#controlPanel QPushButton#primary:focus { border-color: #E8EAED; }
QFrame#controlPanel QPushButton#primary:disabled { background: #171A21; color: #9AA0A6; border-color: #2A2F3A; }
QPushButton#stopAction:enabled { border-color: #9AA0A6; }
QPushButton[regionRole="start"] { color: #3B82F6; }
QPushButton[regionRole="position"] { color: #EAB308; }
QPushButton[regionRole="start"]:checked { border: 2px solid #3B82F6; padding: 8px 11px; }
QPushButton[regionRole="position"]:checked { border: 2px solid #EAB308; padding: 8px 11px; }
QPushButton[regionRole]:!checked:focus { border: 1px solid #9AA0A6; padding: 9px 12px; }
QLabel#startRegionLabel { color: #3B82F6; }
QLabel#positionRegionLabel { color: #EAB308; }
QToolButton {
    background: #1E222B;
    border: 1px solid #2A2F3A;
    border-radius: 4px;
    padding: 6px;
    min-width: 20px;
    min-height: 20px;
}
QToolButton:hover, QToolButton:focus { border-color: #9AA0A6; }
QToolButton:disabled { color: #9AA0A6; background: #171A21; }
QLineEdit, QSpinBox, QDoubleSpinBox {
    background: #1E222B;
    border: 1px solid #2A2F3A;
    border-radius: 4px;
    padding: 6px;
    selection-background-color: #3B82F6;
    selection-color: #0F1115;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus { border-color: #3B82F6; }
QLineEdit:disabled { color: #9AA0A6; }
QComboBox {
    background: #1E222B;
    border: 1px solid #2A2F3A;
    border-radius: 4px;
    padding: 6px;
    min-height: 18px;
    selection-background-color: #2A2F3A;
}
QComboBox:hover { border-color: #9AA0A6; }
QComboBox:focus { border-color: #3B82F6; }
QComboBox:disabled { color: #9AA0A6; background: #171A21; }
QComboBox QAbstractItemView { background: #1E222B; color: #E8EAED; selection-background-color: #2A2F3A; }
QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 16px; height: 16px; }
QCheckBox::indicator:unchecked { background: #1E222B; border: 1px solid #9AA0A6; }
QCheckBox:focus { outline: 1px solid #3B82F6; }
QCheckBox:disabled { color: #9AA0A6; }
QTabWidget::pane { border: 1px solid #2A2F3A; }
QTabBar::tab { background: #171A21; color: #9AA0A6; padding: 8px; border-bottom: 2px solid #2A2F3A; }
QTabBar::tab:selected { background: #1E222B; color: #E8EAED; border-bottom-color: #3B82F6; }
QTabBar::tab:hover, QTabBar::tab:focus { color: #E8EAED; background: #2A2F3A; }
QTableWidget {
    background: #171A21;
    alternate-background-color: #1E222B;
    gridline-color: #2A2F3A;
    border: 1px solid #2A2F3A;
    selection-background-color: #2A2F3A;
    selection-color: #E8EAED;
}
QHeaderView::section { background: #1E222B; color: #9AA0A6; border: none; padding: 8px; }
QTableWidget::item { padding: 5px; }
QTableWidget:focus { border-color: #3B82F6; }
QPlainTextEdit { background: #171A21; border: 1px solid #2A2F3A; padding: 8px; }
QMenuBar { background: #0F1115; border-bottom: 1px solid #253443; padding: 4px 12px; spacing: 4px; }
QMenuBar::item { padding: 6px 12px; background: transparent; border-radius: 4px; }
QMenuBar::item:selected { background: #2A2F3A; }
QMenuBar::item:pressed { background: #20394E; color: #E8EAED; }
QMenu { background: #1E222B; border: 1px solid #39414D; padding: 6px; }
QMenu::item { padding: 9px 28px 9px 12px; border-radius: 3px; }
QMenu::item:selected { background: #20394E; color: #E8EAED; }
QMenu::separator { height: 1px; background: #39414D; margin: 5px 6px; }
QMenu::item:disabled { color: #9AA0A6; }
QSplitter::handle { background: transparent; }
QSplitter::handle:horizontal { width: 6px; }
QSplitter::handle:vertical { height: 6px; }
QSplitter::handle:hover { background: #60A5FA; }
QScrollBar:vertical { background: #171A21; width: 10px; }
QScrollBar::handle:vertical { background: #2A2F3A; min-height: 24px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: #171A21; height: 10px; }
QScrollBar::handle:horizontal { background: #39414D; min-width: 24px; }
QScrollBar::handle:hover { background: #9AA0A6; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QAbstractScrollArea::corner { background: #171A21; }
QToolTip { color: #E8EAED; background: #1E222B; border: 1px solid #9AA0A6; padding: 6px; }

/* Refined monitor hierarchy and compact state indicators. */
QWidget#monitorSurface { background-color: #0A1017; }
QWidget#monitorHeader { padding-bottom: 6px; border-bottom: 1px solid #263647; }
QLabel#title { color: #F5F8FC; font-size: 20px; font-weight: 700; letter-spacing: 0.4px; }
QFrame#cameraPanel, QFrame#verdictPanel, QFrame#controlPanel {
    background-color: #101A25;
    border: 1px solid #2A3A4B;
    border-radius: 10px;
}
QFrame#cameraPanel { border-top: 2px solid #35516B; }
QFrame#verdictPanel { border-top: 2px solid #4B6B87; }
QFrame#controlPanel { border-top: 2px solid #3A6B52; }
QLabel#panelTitle { color: #B7C7D8; font-size: 11px; font-weight: 700; letter-spacing: 0.8px; }
QLabel#sectionTitle { color: #E8EEF5; font-size: 15px; font-weight: 600; }
QLabel#caption { color: #9EADBD; }
QLabel#counter { color: #F5F8FC; font-size: 30px; font-weight: 700; }
QLabel#statusBadge {
    background-color: #1B2734;
    color: #BEC9D5;
    border: 1px solid #344454;
    border-radius: 11px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}
QLabel#statusBadge[status="active"] { color: #8DE0A8; background-color: #14291F; border-color: #2B6841; }
QLabel#statusBadge[status="attention"] { color: #FFD27A; background-color: #302515; border-color: #795A25; }
QLabel#statusBadge[status="offline"] { color: #AEB9C5; }
QWidget#cameraToolbar QPushButton, QWidget#monitorHeader QPushButton { border-radius: 7px; }
QPushButton#primary { background: #277A4A; border-color: #3F9A64; color: #F4FFF7; }
QPushButton#primary:hover { background: #318B57; border-color: #70C18B; }
QPushButton#primary:pressed { background: #1D613A; }
QPushButton#stopAction { color: #FFD2D7; border-color: #74434C; background: #2A1A1F; }
QPushButton#stopAction:hover { background: #3A2027; border-color: #B75B6C; }
QPushButton:focus, QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QPlainTextEdit:focus, QTableWidget:focus { border: 2px solid #69A9F5; }
QTableWidget { border-radius: 7px; alternate-background-color: #131C27; }
QHeaderView::section { font-size: 11px; font-weight: 600; }
QScrollBar:vertical, QScrollBar:horizontal { border-radius: 5px; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { border-radius: 5px; }
